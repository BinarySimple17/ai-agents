# .env.example — шаблон локальных настроек. Скопируйте в .env (в git не попадает)
# и заполните секреты. Обязательные переменные валидируются на старте (fail-fast).

# --- LLM-шлюз (OpenAI-совместимый; D-020: по умолчанию локальный LM Studio) ---
# Пусто или не задано → http://127.0.0.1:1234/v1 (LM Studio; 127.0.0.1, не localhost —
# IPv6-ловушка Windows, как в DSN). Путь дефолта — /v1: это OpenAI-совместимый API
# LM Studio; его /api/v1 — собственный REST (SDK получает на нём 404).
LLM_BASE_URL=
# Переключение на облако routerai.ru — 5 шагов: (1) раскомментировать URL ниже;
# (2) вписать реальный ключ; (3) вернуть тройку MODEL_* из hw-01 §4.2 (строки ниже);
# (4) вернуть цены снимка model-card; (5) ОЧИСТИТЬ LLM_REASONING_EFFORT (параметр
# локального шлюза; облаку отправлять не предполагалось). Иначе шлюз вернёт
# 404 «model not found».
# LLM_BASE_URL=https://routerai.ru/api/v1
# Ключ шлюза (в git не попадает). LM Studio ключ не проверяет — любой непустой
# ASCII-плейсхолдер (кириллица в ключе ломает заголовок Authorization);
# для облака — реальный ключ routerai.ru.
LLM_API_KEY=sk-local
# Таймаут одного вызова шлюза, с (S00 правило 9). Таймаут — отказ узла,
# но НЕ сбой circuit breaker (breaker считает ошибки, не медлительность).
# Локально 60: первая загрузка модели в память LM Studio может занять минуту.
LLM_REQUEST_TIMEOUT_S=60
# Гашение reasoning-канала шлюза (S25/feat-020): reasoning-модели (qwen3) нередко
# кладут финальный ответ в reasoning_content — тогда стрим приходит одним
# фолбэк-чанком и потоковый вывод ДЗ-03 не виден. "none" — гасит thinking
# (контент стримит чанками); пусто — параметр не отправляется (облачные шлюзы).
# Локально (D-020) ставьте none — иначе финальный ответ уходит в reasoning_content
# и стрим приходит одним фолбэк-чанком (см. model-card §1)
LLM_REASONING_EFFORT=
# Роли моделей (ADR-007 §4, «узел → навык → модель»). Локально — одна модель на все
# роли; тройка облака из hw-01 §4.2:
# MODEL_CHEAP=qwen/qwen3.7-flash
# MODEL_MID=deepseek/deepseek-v4.1-flash-1017
# MODEL_STRONG=z-ai/glm-5.3-prime
MODEL_CHEAP=qwen3.8-9b
MODEL_MID=qwen3.8-9b
MODEL_STRONG=qwen3.8-9b
# Жёсткий кап бюджета на один запрос пользователя (₽)
BUDGET_PER_REQUEST_RUB=2
# Цены ролей (₽/1М токенов, вход/выход) — расчёт cost_rub и капа (model-card; дрейф цен — R-C1).
# Локальная модель бесплатна (0); для облака — тарифы снимка model-card:
# MODEL_CHEAP_PRICE_IN=3.20 / MODEL_CHEAP_PRICE_OUT=13 / MODEL_MID_PRICE_IN=8 /
# MODEL_MID_PRICE_OUT=12 / MODEL_STRONG_PRICE_IN=299 / MODEL_STRONG_PRICE_OUT=939
MODEL_CHEAP_PRICE_IN=0
MODEL_CHEAP_PRICE_OUT=0
MODEL_MID_PRICE_IN=0
MODEL_MID_PRICE_OUT=0
MODEL_STRONG_PRICE_IN=0
MODEL_STRONG_PRICE_OUT=0
# Эмбеддер (индексация DDL/глоссария/few-shot — model-card; S06): локально —
# text-embedding-bge-m3 (id сверен с живым GET /v1/models LM Studio 2026-11-20);
# облако — qwen/qwen3-embedding-8b
EMBEDDING_MODEL=text-embedding-bge-m3
# Endpoint эмбеддера (D-025): пусто → тот же локальный LM Studio http://127.0.0.1:1234/v1;
# авторизация — общий LLM_API_KEY (отдельный секрет не вводится); при облаке routerai —
# https://routerai.ru/api/v1 и EMBEDDING_MODEL=qwen/qwen3-embedding-8b.
# Смена эмбеддера = переиндексация; облачный qwen3-embedding-8b имеет ДРУГУЮ размерность
# (не 1024) — смена требует и миграции vector(N) в agent_knowledge, не только сидов.
EMBEDDING_BASE_URL=

# Журнал событий узлов (FR-11): JSONL вне git (см. .gitignore)
TRACE_JSONL_PATH=.harness/traces/trace.jsonl

# --- PostgreSQL (хранилище истины: данные + pgvector + настройки + query_trace) ---
# Host — 127.0.0.1 (НЕ localhost: на Windows IPv6 ::1 молча дропается, +60s на коннект)
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/agent
# Read-only роль для пользовательского SQL (создаётся МИГРАЦИЕЙ feat-002 — S00 правило 5, D-009)
AGENT_RO_DSN=postgresql://agent_ro:agent_ro@127.0.0.1:5432/agent

# --- Valkey (кэш вопросов, ADR-009 v1.2) ---
VALKEY_URL=redis://127.0.0.1:6379/0

# --- Neo4j (граф связей — ADR-003 v2.0) ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-dev-password

# --- docker compose ---
POSTGRES_DB=agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
NEO4J_PASSWORD=neo4j-dev-password

# --- Роли БД (создаются миграцией S02; пароли — из .env, не из кода; FIX-007) ---
# ВАЖНО: AGENT_RO_PASSWORD и пароль в AGENT_RO_DSN (то же для trace) — два места
# с одним значением; менять синхронно.
AGENT_RO_PASSWORD=agent_ro
AGENT_PLANNER_PASSWORD=agent_planner
AGENT_TRACE_PASSWORD=agent_trace
REGISTRY_WRITER_PASSWORD=registry_writer
# DSN трейс-канала — второй SQL-канал (security §2.2)
AGENT_TRACE_DSN=postgresql://agent_trace:agent_trace@127.0.0.1:5432/agent

# --- Dev-аутентификация FSM (S05, ruling R4: identity — только из проверенного токена) ---
# Токены демо-пользователей "user_id:token,..." (сиды ролей — миграция 0003);
# CLI --fsm требует --token из этого списка; production — OIDCAuth за портом.
AGENT_DEV_TOKENS=u_analyst:dev-analyst-token,u_logist:dev-logist-token,u_hr:dev-hr-token
